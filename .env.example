# RetailPulse Environment Configuration Template
# Copy to .env and populate strong, non-default values before running in production.

APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
LOG_DIR=logs
BACKUP_DIR=backups/postgres

# Local Development PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retailpulse_db
DB_USER=postgres
DB_PASSWORD=change_me_local_db_password

# API Security & Rate Limiting
RETAILPULSE_API_KEY=change_me_api_key
API_AUTH_REQUIRED=true
API_RATE_LIMIT_PER_MIN=120

# Docker Compose Application PostgreSQL
DOCKER_DB_NAME=retailpulse_docker_db
DOCKER_DB_USER=retailpulse_app
DOCKER_DB_PASSWORD=change_me_docker_db_pass

# Docker Compose Airflow Metadata PostgreSQL & Fernet Encryption Key
AIRFLOW_DB_NAME=airflow_meta
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow_db_pass
AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key

# Optional Cloud Storage Integration
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_CONTAINER_NAME=