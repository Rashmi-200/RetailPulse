# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Local Paths
DATA_DIR=./data
LOG_DIR=./logs

# PostgreSQL Operational & Metadata Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retailpulse_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Azure Storage & Data Factory
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_CONTAINER_NAME=retailpulse-lakehouse
